@model List<RaceDay.MVC.Models.ResultListItemDto>

@{
    ViewData["Title"] = "Manage Results";
    var eventId = ViewBag.EventId;
    var eventName = ViewBag.EventName as string;
}

<div class="dashboard-heading mb-4">
    <div>
        <span class="section-label">
            <i class="bi bi-trophy"></i> ORGANISER AREA
        </span>
        <h1 class="page-title mt-2">Event Results</h1>
        <p class="text-muted mb-0">
            @(string.IsNullOrWhiteSpace(eventName) ? "Capture and publish results." : eventName)
        </p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-primary rounded-pill px-4">
        <i class="bi bi-arrow-left me-2"></i> Back to Dashboard
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="content-card h-100">
            <h4 class="mb-3">Captured Results</h4>
            @if (Model == null || !Model.Any())
            {
                <div class="empty-state text-center py-4">
                    <i class="bi bi-hourglass-split"></i>
                    <h5 class="mt-3">No results captured yet</h5>
                    <p class="text-muted mb-0">Use the form on the right to add the first result.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table raceday-table align-middle">
                        <thead>
                            <tr>
                                <th>Participant</th>
                                <th>Finish Time</th>
                                <th>Position</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var res in Model)
                            {
                                <tr>
                                    <td><strong>@res.ParticipantName</strong></td>
                                    <td class="fw-bold text-primary">@res.FinishTime</td>
                                    <td>@res.FinishingPosition</td>
                                    <td>
                                        <span class="badge status-@res.Status.ToLower()">@res.Status</span>
                                        @if (res.IsPublished)
                                        {
                                            <span class="badge status-published ms-1">Published</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="content-card">
            <h4 class="mb-3">
                <i class="bi bi-plus-circle text-primary me-2"></i>Capture New Result
            </h4>
            <form asp-action="CreateResult" asp-route-eventId="@eventId" method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Enrolment ID</label>
                    <input name="EnrolmentId" type="number" class="form-control" required />
                    <small class="text-muted">Find this on the Enrolments page.</small>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Finish Time</label>
                    <input name="FinishTime" type="time" step="1" class="form-control" />
                </div>
                <div class="row">
                    <div class="col-6 mb-3">
                        <label class="form-label fw-bold">Overall Pos</label>
                        <input name="OverallPlacement" type="number" class="form-control" />
                    </div>
                    <div class="col-6 mb-3">
                        <label class="form-label fw-bold">Category Pos</label>
                        <input name="CategoryPlacement" type="number" class="form-control" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Status</label>
                    <select name="Status" class="form-select" required>
                        <option value="Finished">Finished</option>
                        <option value="DNF">DNF (Did Not Finish)</option>
                        <option value="DQ">DQ (Disqualified)</option>
                    </select>
                </div>
                <button type="submit" class="btn btn-success w-100">
                    <i class="bi bi-check-circle me-2"></i> Save Result
                </button>
            </form>
        </div>
    </div>
</div>