@model List<RaceDay.MVC.Models.EventResponseDto>

@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="dashboard-heading mb-4">
    <div>
        <span class="section-label">
            <i class="bi bi-speedometer2"></i> ORGANISER AREA
        </span>

        <h1 class="page-title mt-2">Organiser Dashboard</h1>

        <p class="text-muted mb-0">
            Welcome, @ViewBag.OrganiserName!
            Manage your events from here.
        </p>
    </div>

    <a class="btn btn-primary rounded-pill px-4"
       asp-controller="Organiser"
       asp-action="CreateEvent">
        <i class="bi bi-plus-circle me-2"></i>
        Create Event
    </a>
</div>

<!-- Dashboard overview -->
<div class="row g-3 mb-4">

    <div class="col-md-4">
        <div class="dashboard-stat-card">
            <div class="stat-icon">
                <i class="bi bi-calendar-event"></i>
            </div>

            <div>
                <p class="stat-label">Your Events</p>
                <h3>@(Model?.Count ?? 0)</h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="dashboard-stat-card">
            <div class="stat-icon">
                <i class="bi bi-people"></i>
            </div>

            <div>
                <p class="stat-label">Participant Management</p>
                <h3>Enrolments</h3>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="dashboard-stat-card">
            <div class="stat-icon">
                <i class="bi bi-trophy"></i>
            </div>

            <div>
                <p class="stat-label">Event Management</p>
                <h3>Results</h3>
            </div>
        </div>
    </div>

</div>

<!-- Events management -->
<div class="content-card">

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h4 class="mb-1">Your Events</h4>
            <p class="text-muted mb-0">
                View and manage your organised events.
            </p>
        </div>

        <span class="event-count">
            @(Model?.Count ?? 0) event(s)
        </span>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state text-center py-5">

            <i class="bi bi-calendar2-plus"></i>

            <h5 class="mt-3">No events yet</h5>

            <p class="text-muted">
                You haven't created any events.
                Create your first event to get started.
            </p>

            <a class="btn btn-primary rounded-pill px-4"
               asp-controller="Organiser"
               asp-action="CreateEvent">
                <i class="bi bi-plus-circle me-2"></i>
                Create Your First Event
            </a>

        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table raceday-table align-middle">

                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Management</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var ev in Model)
                    {
                        <tr>

                            <td>
                                <div class="d-flex align-items-center gap-2">

                                    <div class="table-icon">
                                        <i class="bi bi-calendar-event"></i>
                                    </div>

                                    <strong>@ev.Name</strong>

                                </div>
                            </td>

                            <td>
                                <i class="bi bi-calendar3 text-primary me-1"></i>
                                @ev.EventDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                <i class="bi bi-geo-alt text-primary me-1"></i>
                                @ev.Location
                            </td>

                            <td>
                                <div class="d-flex flex-wrap gap-2">

                                    <a class="btn btn-sm btn-outline-primary rounded-pill"
                                       asp-action="Categories"
                                       asp-route-eventId="@ev.EventID">
                                        <i class="bi bi-tags me-1"></i>
                                        Categories
                                    </a>

                                    <a class="btn btn-sm btn-outline-primary rounded-pill"
                                       asp-action="Enrolments"
                                       asp-route-eventId="@ev.EventID">
                                        <i class="bi bi-people me-1"></i>
                                        Enrolments
                                    </a>

                                    <a class="btn btn-sm btn-outline-primary rounded-pill"
                                       asp-action="Results"
                                       asp-route-eventId="@ev.EventID">
                                        <i class="bi bi-trophy me-1"></i>
                                        Results
                                    </a>

                                </div>
                            </td>

                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }

</div>

