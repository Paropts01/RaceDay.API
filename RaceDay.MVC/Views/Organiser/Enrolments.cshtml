@model List<RaceDay.MVC.Models.EventEnrolmentListItemDto>

@{
    ViewData["Title"] = "Event Enrolments";
    var eventId = ViewBag.EventId;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Event Enrolments</h2>
        <a asp-action="Dashboard" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-striped mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Participant</th>
                        <th>Email</th>
                        <th>Category</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Payment</th>
                        <th>Bib #</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center py-4">No enrolments yet.</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.ParticipantName</td>
                            <td>@item.Email</td>
                            <td>@item.Category</td>
                            <td>@item.EnrolmentDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge status-@item.Status.ToLower()">@item.Status</span>
                            </td>
                            <td>@item.PaymentStatus</td>
                            <td>@item.BibNumber</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
