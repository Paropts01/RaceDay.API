@model List<RaceDay.MVC.Models.EventEnrolmentListItemDto>

@{
    ViewData["Title"] = "Event Enrolments";
    var eventId = ViewBag.EventId;
    var eventName = ViewBag.EventName as string;
}

<div class="dashboard-heading mb-4">
    <div>
        <span class="section-label">
            <i class="bi bi-people"></i> ORGANISER AREA
        </span>
        <h1 class="page-title mt-2">Event Enrolments</h1>
        <p class="text-muted mb-0">
            @(string.IsNullOrWhiteSpace(eventName) ? "Participant entries for this event." : eventName)
        </p>
    </div>
    <a asp-action="Dashboard" class="btn btn-outline-primary rounded-pill px-4">
        <i class="bi bi-arrow-left me-2"></i> Back to Dashboard
    </a>
</div>

<div class="content-card">
    @if (Model == null || !Model.Any())
    {
        <div class="empty-state text-center py-5">
            <i class="bi bi-people"></i>
            <h5 class="mt-3">No enrolments yet</h5>
            <p class="text-muted">Participants will appear here once they enter this event.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table raceday-table align-middle">
                <thead>
                    <tr>
                        <th>Participant</th>
                        <th>Email</th>
                        <th>Category</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Payment</th>
                        <th>Bib #</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="table-icon"><i class="bi bi-person"></i></div>
                                    <strong>@item.ParticipantName</strong>
                                </div>
                            </td>
                            <td>@item.Email</td>
                            <td>@item.Category</td>
                            <td>@item.EnrolmentDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <span class="badge status-@item.Status.ToLower()">@item.Status</span>
                            </td>
                            <td>
                                <span class="badge payment-@item.PaymentStatus.ToLower()">@item.PaymentStatus</span>
                            </td>
                            <td>

                                @if (!item.BibNumber.HasValue)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    <strong>@item.BibNumber</strong>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
}
