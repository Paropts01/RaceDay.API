@model RaceDay.MVC.Models.EventCreateDto

@{
    ViewData["Title"] = "Create Event";
}

<div class="container mt-4">
    <h2>Create a New Event</h2>
    <hr />

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <div class="row">
        <div class="col-md-8">
            <form asp-action="CreateEvent" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label fw-bold">Event Name</label>
                    <input name="Name" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Description</label>
                    <textarea name="Description" class="form-control" rows="3"></textarea>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Event Date</label>
                        <input name="EventDate" type="date" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Location</label>
                        <input name="Location" class="form-control" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Distance (km)</label>
                        <input name="Distance" type="number" step="0.1" class="form-control" required />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Event Type</label>
                        <select name="EventType" class="form-select" required>
                            <option value="Run">Run</option>
                            <option value="Walk">Walk</option>
                            <option value="Cycle">Cycle</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Max Participants</label>
                        <input name="MaxParticipants" type="number" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Registration Deadline</label>
                        <input name="RegistrationDeadline" type="datetime-local" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Banner Image (Azure Blob)</label>
                        <input name="banner" type="file" accept="image/*" class="form-control" />
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-success px-4">Create Event</button>
                    <a asp-action="Dashboard" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
