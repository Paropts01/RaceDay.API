@model RaceDay.MVC.Models.EventResponseDto

@{
    var categories =
        ViewBag.Categories as List<RaceDay.MVC.Models.CategoryResponseDto>
        ?? new List<RaceDay.MVC.Models.CategoryResponseDto>();

    var role = Context.Session.GetString("Role");
    var alreadyEnrolled = ViewBag.AlreadyEnrolled as bool? ?? false;
}

<div class="mb-3">
    <a asp-controller="Home"
       asp-action="Index"
       class="clear-filter-link">
        <i class="bi bi-arrow-left me-1"></i> Back to Events
    </a>
</div>

<div class="events-heading mb-4">
    <div>
        <span class="section-label">
            <i class="bi bi-flag"></i> EVENT DETAILS
        </span>

        <h1 class="page-title mt-2">@Model.Name</h1>

        <p class="text-muted mb-0">
            <i class="bi bi-geo-alt me-1"></i> @Model.Location
            &nbsp;·&nbsp;
            <i class="bi bi-calendar3 me-1"></i> @Model.EventDate.ToString("dd MMM yyyy")
            &nbsp;·&nbsp;
            <i class="bi bi-signpost-2 me-1"></i> @Model.Distance km
        </p>
    </div>

    <span class="event-type-badge">
        <i class="bi bi-activity me-1"></i> @Model.EventType
    </span>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger raceday-alert" role="alert">
        <i class="bi bi-exclamation-circle-fill"></i>
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success raceday-alert" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        @TempData["Success"]
    </div>
}

<div class="content-card mb-4">
    <h4 class="mb-3">
        <i class="bi bi-info-circle text-primary me-2"></i>About This Event
    </h4>

    @if (!string.IsNullOrWhiteSpace(Model.BannerImageURL))
    {
        <div class="event-image-wrapper mb-3" style="height: 320px; border-radius: 16px;">
            <img src="@Model.BannerImageURL"
                 alt="Banner for @Model.Name"
                 class="event-image" />
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p>@Model.Description</p>
    }
    else
    {
        <p class="text-muted">No description provided for this event.</p>
    }

    <div class="row g-3 mt-3">
        <div class="col-md-4">
            <div class="dashboard-stat-card">
                <div class="stat-icon">
                    <i class="bi bi-calendar3"></i>
                </div>
                <div>
                    <p class="stat-label">Event Date</p>
                    <h3 style="font-size: 1.05rem;">@Model.EventDate.ToString("dd MMM yyyy")</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="dashboard-stat-card">
                <div class="stat-icon">
                    <i class="bi bi-geo-alt"></i>
                </div>
                <div>
                    <p class="stat-label">Location</p>
                    <h3 style="font-size: 1.05rem;">@Model.Location</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="dashboard-stat-card">
                <div class="stat-icon">
                    <i class="bi bi-signpost-2"></i>
                </div>
                <div>
                    <p class="stat-label">Distance</p>
                    <h3 style="font-size: 1.05rem;">@Model.Distance km</h3>
                </div>
            </div>
        </div>
    </div>
</div>

@if (role == "Organiser")
{
    <div class="content-card mb-4">
        <h4 class="mb-3">
            <i class="bi bi-image text-primary me-2"></i>Upload Event Banner
        </h4>

        <p class="text-muted">
            Select a JPG, JPEG, PNG or WEBP image. Maximum size: 5 MB.
        </p>

        <form asp-controller="Events"
              asp-action="UploadBanner"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <input type="hidden" name="eventId" value="@Model.EventID" />

            <div class="mb-3">
                <label for="banner" class="form-label">
                    Select banner image
                </label>

                <input type="file"
                       id="banner"
                       name="banner"
                       class="form-control"
                       accept=".jpg,.jpeg,.png,.webp"
                       required />
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-cloud-upload me-2"></i> Upload Banner
            </button>
        </form>
    </div>
}

<div class="mb-3">
    <h3 class="events-section-title">
        <i class="bi bi-tags text-primary me-2"></i>Categories
    </h3>
    <p class="text-muted small mb-0">
        Choose a category that suits your age or preferred distance.
    </p>
</div>

@if (!categories.Any())
{
    <div class="content-card empty-state text-center py-4 mb-4">
        <i class="bi bi-tags"></i>
        <h5 class="mt-3">No categories yet</h5>
        <p class="text-muted mb-0">
            The organiser hasn't added any categories to this event yet.
        </p>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        @foreach (var c in categories)
        {
            <div class="col-md-6">
                <div class="content-card h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-1">@c.Name</h5>
                            <p class="text-muted mb-0 small">
                                <i class="bi bi-bookmark me-1"></i>@c.CategoryType
                            </p>
                        </div>
                        <span class="event-type-badge">
                            @(c.EntryFee.HasValue ? $"R{c.EntryFee}" : "Free")
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (role == "Participant")
{
    if (alreadyEnrolled)
    {
        <div class="content-card mb-4" style="border-color: #86efac;">
            <h4 class="mb-2">
                <i class="bi bi-check-circle-fill text-success me-2"></i>
                You're already entered
            </h4>
            <p class="text-muted mb-3">
                You have already registered for this event. View your entry details on
                the <strong>My Events</strong> page.
            </p>
            <a asp-controller="Participant"
               asp-action="MyEvents"
               class="btn btn-outline-primary rounded-pill px-4">
                <i class="bi bi-ticket-perforated me-2"></i> View My Events
            </a>
        </div>
    }
    else if (categories.Any())
    {
        <div class="content-card mb-4">
            <h4 class="mb-3">
                <i class="bi bi-ticket-perforated text-primary me-2"></i>Enter This Event
            </h4>

            <form asp-controller="Events"
                  asp-action="Enrol"
                  asp-route-eventId="@Model.EventID"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="categoryId" class="form-label">
                        Select category
                    </label>

                    <select id="categoryId"
                            name="categoryId"
                            class="form-select"
                            required>
                        @foreach (var c in categories)
                        {
                            <option value="@c.CategoryID">
                                @c.Name
                                @(c.EntryFee.HasValue ? $" - R{c.EntryFee}" : " - Free")
                            </option>
                        }
                    </select>
                </div>

                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle me-2"></i> Enter Event
                </button>
            </form>
        </div>
    }
    else
    {
        <div class="content-card empty-state text-center py-4 mb-4">
            <i class="bi bi-hourglass-split"></i>
            <h5 class="mt-3">Entries not open yet</h5>
            <p class="text-muted mb-0">
                Categories for this event haven't been set up yet.
                Please check back soon.
            </p>
        </div>
    }
}
