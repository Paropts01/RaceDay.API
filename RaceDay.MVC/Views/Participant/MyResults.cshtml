@model List<RaceDay.MVC.Models.MyResultDto>

@{
    ViewData["Title"] = "My Results";
}

<div class="dashboard-heading mb-4">
    <div>
        <span class="section-label">
            <i class="bi bi-trophy"></i> RACE HISTORY
        </span>
        <h1 class="page-title mt-2">My Results</h1>
        <p class="text-muted mb-0">
            Your finish times, positions and overall performance.
        </p>
    </div>
</div>

<div class="content-card">
    @if (Model == null || !Model.Any())
    {
        <div class="empty-state text-center py-5">
            <i class="bi bi-trophy"></i>
            <h5 class="mt-3">No results yet</h5>
            <p class="text-muted">Results will appear here once you complete an event.</p>
            <a class="btn btn-primary rounded-pill px-4"
               asp-controller="Home" asp-action="Index">
                <i class="bi bi-search me-2"></i> Browse Events
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table raceday-table align-middle">
                <thead>
                    <tr>
                        <th>Event</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Finish Time</th>
                        <th>Overall</th>
                        <th>Category</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var res in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="table-icon"><i class="bi bi-flag"></i></div>
                                    <strong>@res.Event</strong>
                                </div>
                            </td>
                            <td>@res.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@res.Category</td>
                            <td class="fw-bold text-primary">@res.FinishTime</td>
                            <td>@res.OverallPlacement</td>
                            <td>@res.CategoryPlacement</td>
                            <td>
                                <span class="badge status-@res.Status.ToLower()">@res.Status</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>