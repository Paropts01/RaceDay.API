@{
ViewData["Title"] = "Privacy Policy";
}

<div class="events-heading mb-4">
    <div>
        <span class="section-label">
            <i class="bi bi-shield-check"></i> LEGAL
        </span>

        <h1 class="page-title mt-2">Privacy Policy</h1>

        <p class="text-muted mb-0">
            How RaceDay collects, uses and protects your personal information.
        </p>
    </div>
</div>

<div class="content-card mb-4">
    <h4 class="mb-3">
        <i class="bi bi-info-circle text-primary me-2"></i>Overview
    </h4>
    <p class="text-muted">
        RaceDay respects your privacy and is committed to protecting your personal
        information. This page explains what we collect, how we use it, and the
        choices you have. By registering or entering events on RaceDay, you agree
        to the practices described here.
    </p>
</div>

<div class="content-card mb-4">
    <h4 class="mb-3">
        <i class="bi bi-database text-primary me-2"></i>Information We Collect
    </h4>
    <ul class="list-group list-group-flush">
        <li class="list-group-item">
            <i class="bi bi-person text-primary me-2"></i>
            <strong>Account details</strong> — your name, email, phone number,
            date of birth and (optionally) a profile picture.
        </li>
        <li class="list-group-item">
            <i class="bi bi-ticket-perforated text-primary me-2"></i>
            <strong>Event entries</strong> — the events and categories you enter,
            along with enrolment status, payment status and bib number.
        </li>
        <li class="list-group-item">
            <i class="bi bi-trophy text-primary me-2"></i>
            <strong>Race results</strong> — finish times, positions and status
            (Finished / DNF / DQ) captured by event organisers.
        </li>
        <li class="list-group-item">
            <i class="bi bi-image text-primary me-2"></i>
            <strong>Uploaded media</strong> — event banners uploaded by organisers
            and profile pictures uploaded by participants.
        </li>
    </ul>
</div>

<div class="content-card mb-4">
    <h4 class="mb-3">
        <i class="bi bi-gear text-primary me-2"></i>How We Use Your Information
    </h4>
    <ul class="list-group list-group-flush">
        <li class="list-group-item">
            <i class="bi bi-check2-circle text-primary me-2"></i>
            To create and manage your RaceDay account.
        </li>
        <li class="list-group-item">
            <i class="bi bi-check2-circle text-primary me-2"></i>
            To process event entries, assign bib numbers and publish race results.
        </li>
        <li class="list-group-item">
            <i class="bi bi-check2-circle text-primary me-2"></i>
            To allow event organisers to manage categories, enrolments and results
            for their events.
        </li>
        <li class="list-group-item">
            <i class="bi bi-check2-circle text-primary me-2"></i>
            To send you service-related notifications (for example, entry
            confirmations).
        </li>
    </ul>
</div>

<div class="content-card mb-4">
    <h4 class="mb-3">
        <i class="bi bi-shield-lock text-primary me-2"></i>How We Protect Your Data
    </h4>
    <p class="text-muted mb-0">
        Passwords are stored using secure hashing. Access to personal information
        is restricted to the organisers of events you have entered, and to our
        internal team where necessary to operate the service. Uploaded images are
        stored in secure, access-controlled storage.
    </p>
</div>

<div class="content-card mb-4">
    <h4 class="mb-3">
        <i class="bi bi-people text-primary me-2"></i>Sharing With Organisers
    </h4>
    <p class="text-muted mb-0">
        When you enter an event, the organiser of that event can view your name,
        email address, chosen category, enrolment status, payment status and bib
        number so that they can run the event smoothly. Organisers cannot view
        your password or data from other events.
    </p>
</div>

<div class="content-card mb-4">
    <h4 class="mb-3">
        <i class="bi bi-envelope text-primary me-2"></i>Contact Us
    </h4>
    <p class="text-muted mb-0">
        For any questions about your personal information, data requests or to
        exercise your rights, please contact our team at
        <a href="mailto:privacy@raceday.co.za">privacy@raceday.co.za</a>.
    </p>
</div>

<div class="text-muted small text-center mb-4">
    <i class="bi bi-clock-history me-1"></i>
    Last updated: @DateTime.Now.ToString("MMMM yyyy")
</div>