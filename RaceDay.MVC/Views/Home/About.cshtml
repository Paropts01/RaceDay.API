@{
    ViewData["Title"] = "About Us";
}

<section class="about-hero mb-5">
    <div class="about-hero-content">
        <span class="home-eyebrow">GET TO KNOW US</span>

        <h1>About RaceDay</h1>

        <p>
            Connecting people through running, walking, cycling
            and unforgettable sporting experiences.
        </p>
    </div>
</section>

<section class="about-information mb-5">
    <div class="about-information-text">
        <span class="section-label">OUR STORY</span>

        <h2>Who We Are</h2>

        <p>
            RaceDay is a platform designed to bring event organisers
            and participants together. We make it easier to discover
            sporting events, manage participation and celebrate
            achievements.
        </p>

        <h2>Our Mission</h2>

        <p>
            Our mission is to make running, walking and cycling events
            more accessible by providing a convenient platform where
            organisers can create events and participants can discover
            and join them.
        </p>

        <h2>What We Offer</h2>

        <ul>
            <li>Discover upcoming running, walking and cycling events.</li>
            <li>Allow organisers to create and manage events.</li>
            <li>Allow participants to enrol in available events.</li>
            <li>Help participants view their events and results.</li>
        </ul>
    </div>
</section>

<section class="about-gallery mb-5">
    <div class="text-center mb-4">
        <h2>Moments That Bring Us Together</h2>
        <p class="text-muted">
            Every event creates an opportunity to challenge yourself
            and celebrate success.
        </p>
    </div>

    <div class="home-photo-grid">
        <div class="home-photo-item">
            <img src="@Url.Content("~/images/crowd.jpg")"
                 alt="Spectators supporting marathon runners" />
            <div class="home-photo-caption">Community Support</div>
        </div>

        <div class="home-photo-item">
            <img src="@Url.Content("~/images/medal.jpg")"
                 alt="Medals awarded to event participants" />
            <div class="home-photo-caption">Celebrating Success</div>
        </div>

        <div class="home-photo-item">
            <img src="@Url.Content("~/images/finish.jpg")"
                 alt="Competitors finishing a race" />
            <div class="home-photo-caption">Unforgettable Moments</div>
        </div>
    </div>
</section>

<section class="home-bottom text-center mb-4">
    <h2>Be Part of the RaceDay Community</h2>
    <p>
        Whether you organise events or participate in them,
        there is a place for you at RaceDay.
    </p>
</section>